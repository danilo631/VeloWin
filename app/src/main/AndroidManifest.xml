<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <queries>
        <package android:name="com.termux.x11"/>
    </queries>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-feature android:name="android.hardware.vulkan.level" android:required="false"/>
    <uses-feature android:glEsVersion="0x00020000" android:required="false"/>

    <application
        android:name=".VeloWinApplication"
        tools:replace="android:name"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:label="VeloWin"
        android:icon="@drawable/velowin_icon"
        android:roundIcon="@drawable/velowin_icon"
        android:usesCleartextTraffic="false"
        android:theme="@style/VeloWinTheme"
        android:supportsRtl="true">
        <provider android:name=".runtime.ComponentApkProvider"
            android:authorities="dev.velowin.app.componentapk"
            android:exported="false"
            android:grantUriPermissions="true"/>
        <!-- Native Xorg is bundled as a library, not a separate launcher. -->
        <activity android:name="com.termux.x11.MainActivity"
            android:exported="false"
            android:theme="@style/LorieAppTheme"
            android:launchMode="singleInstance"
            android:configChanges="fontScale|orientation|screenSize|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|screenLayout|touchscreen|uiMode|smallestScreenSize|density"
            tools:node="replace"/>
        <activity android:name="com.termux.x11.LoriePreferences"
            android:exported="false" tools:replace="android:exported"/>
        <receiver android:name="com.termux.x11.LorieApp$Receiver"
            android:exported="false" tools:replace="android:exported"/>
        <activity android:name=".ComponentCenterActivity" android:exported="false"
            android:screenOrientation="unspecified"/>
        <activity android:name=".ContainerFilesActivity" android:exported="false"
            android:screenOrientation="unspecified"/>
        <service android:name=".engine.EmbeddedX11Service"
            android:exported="false"
            android:process=":velowin_x11"
            android:stopWithTask="true"/>
        <activity android:name=".ContainerLabActivity" android:exported="false"
            android:screenOrientation="unspecified"/>
        <activity android:name=".hardware.VirtualControllerLabActivity"
            android:exported="false" android:screenOrientation="unspecified"/>
        <activity android:name=".hardware.VulkanWsiLabActivity"
            android:exported="false" android:screenOrientation="unspecified"/>
        <activity android:name=".hardware.GpuSurfaceLabActivity"
            android:exported="false" android:screenOrientation="unspecified"/>
        <activity android:name=".hardware.InputAudioLabActivity"
            android:exported="false" android:screenOrientation="unspecified"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
